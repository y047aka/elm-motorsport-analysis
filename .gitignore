# The geometry and circuit maps, copied from the circuit-maps-3d flake input
# by the commands that read them (dev, build, test, VRT, Tauri). The bytes are
# owned upstream; a bare elm-test without them fails to compile by name.
app/static/geometry/
app/static/circuit-maps/

# Generated by app/scripts/test-fixtures.mjs: the served geometry and the
# circuit maps as Elm test modules. nix run .#test writes them; a bare elm-test
# without them fails to compile by name.
package/tests/Motorsport/TestHelpers/Survey/
package/tests/Motorsport/TestHelpers/Map/

# Written by app/codegen (the flake's generateElm).
app/generated/

# Flix compiler scratch dir if invoked from repo root
/build/

# elm-verify-examples generated files
VerifyExamples

# Generated CSS
app/public/style.css

# Generated benchmark fixtures (run `nix run .#benchmark`)
package/benchmark/Fixture/Generated.elm
package/benchmark/Fixture/Positions.elm
test-results/
