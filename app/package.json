    "build": "pnpm run css:build && elm-pages build",
    "test": "playwright test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.1.1",
    "daisyui": "5.6.18",
    "elm-codegen": "0.6.3",
    "elm-optimize-level-2": "0.4.0",
    "elm-pages": "3.5.1",
    "tailwindcss": "4.3.3",
    "vite": "7.3.2"
  }
}
