{
  "name": "app",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "css:build": "tailwindcss -i style.css -o public/style.css --minify",
    "css:watch": "tailwindcss -i style.css -o public/style.css --watch",
    "start": "pnpm run css:build && vite",
    "build": "pnpm run css:build && vite build",
    "test": "playwright test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.2",
    "vite-plugin-elm": "3.0.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  }
}
