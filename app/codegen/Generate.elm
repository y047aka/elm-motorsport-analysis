module Generate exposing (main)

{-| Writes `data/wec/manufacturers.json` out as `Generated.Data.Wec.Manufacturer.Table`, read with the app's own [`Data.Wec.Manufacturer.decoder`](Data-Wec-Manufacturer#decoder), so a table the app would refuse fails the build instead.

The file arrives as the flags: `elm-codegen run --flags-from`.

-}

import Data.Wec.Manufacturer as Manufacturer exposing (Manufacturers)
import Dict
import Elm
import Elm.Annotation as Type
import Gen.CodeGen.Generate as Generate
import Json.Decode as Decode
import Motorsport.Manufacturer exposing (Manufacturer)


main : Program Decode.Value () ()
main =
    Generate.fromJson Manufacturer.decoder (\table -> [ file table ])


file : Manufacturers -> Elm.File
file table =
    Elm.fileWith [ "Generated", "Data", "Wec", "Manufacturer", "Table" ]
        { docs = "Generated by `app/codegen` from `data/wec/manufacturers.json`. Do not edit: every command that builds the app writes it again from the file."
        , aliases = []
        }
        [ Elm.declaration "table"
            (Elm.apply
                (Elm.value { importFrom = [ "Dict" ], name = "fromList", annotation = Nothing })
                [ Elm.list (List.map entry (Dict.toList table)) ]
                |> Elm.withType (Type.named [ "Data", "Wec", "Manufacturer" ] "Manufacturers")
            )
            |> Elm.expose
        ]


entry : ( String, Manufacturer ) -> Elm.Expression
entry ( key, manufacturer ) =
    Elm.tuple (Elm.string key)
        (Elm.record
            [ ( "name", Elm.string manufacturer.name )
            , ( "color", Elm.string manufacturer.color )
            , ( "logoUrl", Elm.maybe (Maybe.map Elm.string manufacturer.logoUrl) )
            ]
        )
