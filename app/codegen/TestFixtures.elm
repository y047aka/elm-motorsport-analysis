module TestFixtures exposing (main)

{-| Writes the pinned geometry and circuit maps out as the Elm modules the
package's tests read, so those tests check the bytes the app ships rather than a
copy kept by hand beside them.

The bytes arrive as flags: `flake.nix` reads them off the `circuit-maps-3d`
input with `builtins.readFile`.

`elm-codegen run` names the module after the file's basename, which is why this
generator sits beside `Generate.elm` rather than under `Generate/`.

-}

import Char
import Dict exposing (Dict)
import Elm
import Gen.CodeGen.Generate as Generate
import Json.Decode as Decode exposing (Decoder)


type alias Flags =
    { geometry : Dict String String
    , maps : Dict String String
    }


main : Program Decode.Value () ()
main =
    Generate.fromJson decoder <|
        \flags ->
            List.concat
                [ files "Survey" "geometry" flags.geometry
                , files "Map" "specs" flags.maps
                ]


decoder : Decoder Flags
decoder =
    Decode.map2 Flags
        (Decode.field "geometry" (Decode.dict Decode.string))
        (Decode.field "maps" (Decode.dict Decode.string))


{-| One helper module per served file, named after the file's stem:
`le_mans.geojson` becomes `Motorsport.TestHelpers.Survey.LeMans`.
-}
files : String -> String -> Dict String String -> List Elm.File
files helper dir table =
    table
        |> Dict.toList
        |> List.map (\( fileName, bytes ) -> moduleFile helper dir fileName bytes)


moduleFile : String -> String -> String -> String -> Elm.File
moduleFile helper dir fileName bytes =
    Elm.fileWith [ "Motorsport", "TestHelpers", helper, pascalCase (stem fileName) ]
        { docs =
            "Generated by `app/codegen/TestFixtures.elm` from\n`" ++ dir ++ "/" ++ fileName ++ "` of the `circuit-maps-3d` flake input: the bytes the\napp ships, so the package's tests read those and not a copy kept by hand. Do\nnot edit; the flake's `generateElm` writes it again from the input."
        , aliases = []
        }
        [ Elm.declaration "text" (Elm.string bytes) |> Elm.expose ]


stem : String -> String
stem fileName =
    fileName
        |> String.split "."
        |> List.head
        |> Maybe.withDefault fileName


pascalCase : String -> String
pascalCase word =
    word
        |> String.split "_"
        |> List.map capitalize
        |> String.concat


capitalize : String -> String
capitalize part =
    case String.uncons part of
        Just ( first, rest ) ->
            String.cons (Char.toUpper first) rest

        Nothing ->
            ""
